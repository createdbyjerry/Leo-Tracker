{
  "$description": "Orbital Watch design tokens v2. Edit this file, then run `npm run build:tokens` to regenerate assets/css/tokens.css and assets/js/tokens.js. Two tiers: `palette` holds raw primitives; every other color token is a semantic alias into it, so a palette change re-skins the whole product.",

  "palette": {
    "$cssPrefix": "p",
    "$type": "color",
    "ink-950":   { "$value": "#03060b", "$description": "Deep space" },
    "ink-900":   { "$value": "#070d15", "$description": "Panel base" },
    "ink-800":   { "$value": "#0d1620", "$description": "Raised surface" },
    "ink-700":   { "$value": "#16232f", "$description": "Track / well" },
    "mist-100":  { "$value": "#e3eef0", "$description": "Brightest neutral" },
    "mist-300":  { "$value": "#a9bdc1", "$description": "Secondary neutral" },
    "mist-500":  { "$value": "#7a9196", "$description": "Tertiary neutral" },
    "mist-700":  { "$value": "#4b5f64", "$description": "Disabled / faint" },
    "signal":    { "$value": "#3dfc9b", "$description": "Signal green — selection, lock" },
    "flare":     { "$value": "#ff6a3d", "$description": "Flare orange — tracked objects" },
    "ion":       { "$value": "#3ee8ff", "$description": "Ion cyan — ground assets" },
    "amber":     { "$value": "#ffc24a", "$description": "Caution" },
    "red":       { "$value": "#ff4d5e", "$description": "Critical" },
    "sky":       { "$value": "#6aa8ff", "$description": "Water / precipitation" },
    "violet":    { "$value": "#b39bff", "$description": "Radar (SAR)" },
    "white":     { "$value": "#ffffff", "$description": "Pure white" }
  },

  "color": {
    "$cssPrefix": "",
    "$type": "color",
    "bg-void":         { "$value": "{palette.ink-950}", "$description": "App background / deep space" },
    "bg-panel":        { "$value": "rgba(7, 13, 21, 0.9)", "$description": "Opaque panel surface, code chips" },
    "bg-raised":       { "$value": "rgba(22, 35, 47, 0.55)", "$description": "Cards and wells inside a panel" },
    "bg-hover":        { "$value": "rgba(61, 252, 155, 0.06)", "$description": "Row hover wash" },
    "line-dim":        { "$value": "rgba(140, 175, 180, 0.16)", "$description": "Hairline borders and dividers" },
    "line-strong":     { "$value": "rgba(140, 175, 180, 0.32)", "$description": "Control borders, focused wells" },
    "accent-tracked":  { "$value": "{palette.flare}", "$rgb": true, "$description": "Tracked satellites, conjunction alerts" },
    "accent-selected": { "$value": "{palette.signal}", "$rgb": true, "$description": "Selected satellite, orbit path, active state" },
    "accent-hover":    { "$value": "{palette.white}", "$rgb": true, "$description": "Hovered satellite in the 3D view" },
    "accent-station":  { "$value": "{palette.ion}", "$rgb": true, "$description": "Ground station marker" },
    "text-primary":    { "$value": "{palette.mist-100}", "$description": "Primary text" },
    "text-dim":        { "$value": "{palette.mist-300}", "$description": "Secondary text, labels (AA on panels)" },
    "text-faint":      { "$value": "{palette.mist-500}", "$description": "Tertiary text: units, ids, hints" },
    "text-disabled":   { "$value": "{palette.mist-700}", "$description": "Disabled controls" }
  },

  "status": {
    "$type": "color",
    "ok":    { "$value": "{palette.signal}", "$rgb": true, "$description": "Nominal / good window" },
    "warn":  { "$value": "{palette.amber}", "$rgb": true, "$description": "Marginal / simulated / stale" },
    "alert": { "$value": "{palette.red}", "$rgb": true, "$description": "Critical / blocked" },
    "info":  { "$value": "{palette.ion}", "$rgb": true, "$description": "Neutral information" }
  },

  "wx": {
    "$type": "color",
    "clear":    { "$value": "#1f6f8b", "$rgb": true, "$description": "Cloud cover 0–30 %: clear sky" },
    "partly":   { "$value": "#7fa9b8", "$rgb": true, "$description": "Cloud cover 30–70 %: partly cloudy" },
    "overcast": { "$value": "#e6eef0", "$rgb": true, "$description": "Cloud cover 70–100 %: overcast" },
    "precip":   { "$value": "{palette.sky}", "$rgb": true, "$description": "Precipitation" },
    "night":    { "$value": "rgba(2, 5, 12, 0.55)", "$description": "Night-side shading on the 2D map" },
    "sar":      { "$value": "{palette.violet}", "$rgb": true, "$description": "Radar sensors — imaging is not blocked by cloud" }
  },

  "font": {
    "$type": "fontFamily",
    "mono":      { "$value": "'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace", "$description": "Data, readouts, IDs" },
    "ui":        { "$value": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Base UI font, body copy" },
    "condensed": { "$value": "'IBM Plex Sans Condensed', 'IBM Plex Sans', system-ui, sans-serif", "$description": "Uppercase labels, section heads, chips" }
  },

  "fw": {
    "$type": "fontWeight",
    "regular":  { "$value": "400" },
    "medium":   { "$value": "500" },
    "semibold": { "$value": "600" }
  },

  "fs": {
    "$type": "fontSize",
    "2xs":  { "$value": "10px", "$description": "Field labels, timestamps" },
    "xs":   { "$value": "11px", "$description": "Eyebrows, section heads, chips" },
    "sm":   { "$value": "12px", "$description": "Buttons, hints, legend" },
    "base": { "$value": "13px", "$description": "Catalog names, body" },
    "md":   { "$value": "14px", "$description": "Field values" },
    "lg":   { "$value": "16px", "$description": "Brand title" },
    "xl":   { "$value": "20px", "$description": "Readout name, clock" },
    "2xl":  { "$value": "28px", "$description": "Page titles" }
  },

  "tracking": {
    "$type": "letterSpacing",
    "tight":   { "$value": "0.01em", "$description": "Large mono readouts" },
    "wide":    { "$value": "0.06em", "$description": "Buttons, brand title" },
    "caps":    { "$value": "0.14em", "$description": "Uppercase labels" },
    "eyebrow": { "$value": "0.22em", "$description": "Eyebrows, section heads" }
  },

  "space": {
    "$type": "dimension",
    "1":  { "$value": "2px" },
    "2":  { "$value": "4px" },
    "3":  { "$value": "6px" },
    "4":  { "$value": "8px" },
    "5":  { "$value": "10px" },
    "6":  { "$value": "12px" },
    "7":  { "$value": "14px" },
    "8":  { "$value": "16px" },
    "9":  { "$value": "20px" },
    "10": { "$value": "24px" },
    "11": { "$value": "32px" },
    "12": { "$value": "40px" }
  },

  "radius": {
    "$type": "dimension",
    "sm":    { "$value": "4px",  "$description": "Buttons, rows, chips" },
    "md":    { "$value": "6px",  "$description": "Swatches, wells" },
    "lg":    { "$value": "8px",  "$description": "Cards" },
    "panel": { "$value": "12px", "$description": "Floating glass panels" },
    "pill":  { "$value": "999px", "$description": "Status pills, segmented controls" }
  },

  "glass": {
    "bg":        { "$value": "rgba(7, 13, 21, 0.62)", "$type": "color", "$description": "Frosted panel fill" },
    "bg-strong": { "$value": "rgba(7, 13, 21, 0.8)", "$type": "color", "$description": "Small floating bars that sit over bright imagery" },
    "header-bg": { "$value": "rgba(3, 6, 11, 0.4)", "$type": "color", "$description": "Panel header strip" },
    "edge":      { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.05)", "$type": "shadow", "$description": "Top-edge highlight on glass" },
    "blur":      { "$value": "16px", "$type": "dimension", "$description": "backdrop-filter blur radius" },
    "saturate":  { "$value": "140%", "$type": "number", "$description": "backdrop-filter saturation" }
  },

  "shadow": {
    "panel": { "$value": "0 18px 40px rgba(0, 0, 0, 0.45)", "$type": "shadow", "$description": "Floating panel drop shadow" },
    "glow":  { "$value": "0 0 8px", "$type": "shadow", "$description": "Glow prefix for status dots: box-shadow: var(--shadow-glow) rgba(var(--x-rgb), .7)" }
  },

  "layout": {
    "$type": "dimension",
    "inset":       { "$value": "{space.8}", "$description": "Gap between floating panels and the viewport edge" },
    "panel-width": { "$value": "340px", "$description": "Mission Control panel width" },
    "rail-width":  { "$value": "{layout.map-width}", "$description": "Right rail (clock + target), aligned with the map" },
    "map-width":   { "$value": "340px", "$description": "Ground-track map width (collapsed)" },
    "map-height":  { "$value": "200px", "$description": "Ground-track map height (collapsed)" }
  },

  "z": {
    "$type": "number",
    "scene":   { "$value": "1", "$description": "WebGL canvas" },
    "scan":    { "$value": "2", "$description": "Scanline sweep" },
    "panel":   { "$value": "6", "$description": "Floating glass panels" },
    "overlay": { "$value": "20", "$description": "Toasts" }
  },

  "motion": {
    "fast": { "$value": "0.15s ease", "$type": "transition", "$description": "Hover and state transitions" },
    "base": { "$value": "0.25s cubic-bezier(0.2, 0.7, 0.2, 1)", "$type": "transition", "$description": "Panels, tabs, expand/collapse" },
    "slow": { "$value": "0.6s cubic-bezier(0.2, 0.7, 0.2, 1)", "$type": "transition", "$description": "Meters and data fills" }
  }
}
