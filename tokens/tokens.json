{
  "$description": "Orbital Watch design tokens. Edit this file, then run `npm run build:tokens` to regenerate assets/css/tokens.css and assets/js/tokens.js.",

  "color": {
    "$cssPrefix": "",
    "$type": "color",
    "bg-void":         { "$value": "#05070a", "$description": "App background / deep space" },
    "bg-panel":        { "$value": "rgba(9, 14, 18, 0.86)", "$description": "Opaque panel surface, code chips" },
    "line-dim":        { "$value": "rgba(120, 150, 140, 0.18)", "$description": "Hairline borders and dividers" },
    "accent-tracked":  { "$value": "#ff5533", "$rgb": true, "$description": "Tracked satellites, conjunction alerts" },
    "accent-selected": { "$value": "#33ff88", "$rgb": true, "$description": "Selected satellite, orbit path, active state" },
    "accent-hover":    { "$value": "#ffffff", "$rgb": true, "$description": "Hovered satellite in the 3D view" },
    "accent-station":  { "$value": "#33ffee", "$rgb": true, "$description": "Ground station marker" },
    "text-primary":    { "$value": "#dfe9e4", "$description": "Primary text" },
    "text-dim":        { "$value": "#6d8479", "$description": "Secondary text, labels" }
  },

  "font": {
    "$type": "fontFamily",
    "mono": { "$value": "'IBM Plex Mono', 'Courier New', monospace", "$description": "Labels, data, HUD chrome" },
    "ui":   { "$value": "'Inter', -apple-system, sans-serif", "$description": "Base UI font" }
  },

  "fs": {
    "$type": "fontSize",
    "2xs":  { "$value": "9px",  "$description": "Field labels, timestamps" },
    "xs":   { "$value": "10px", "$description": "Eyebrows, panel labels, conjunction rows" },
    "sm":   { "$value": "11px", "$description": "Buttons, hints, legend" },
    "base": { "$value": "12px", "$description": "Catalog names" },
    "md":   { "$value": "13px", "$description": "Field values" },
    "lg":   { "$value": "15px", "$description": "Brand title" },
    "xl":   { "$value": "17px", "$description": "Readout name" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "2px" },
    "2": { "$value": "3px" },
    "3": { "$value": "6px" },
    "4": { "$value": "8px" },
    "5": { "$value": "10px" },
    "6": { "$value": "12px" },
    "7": { "$value": "14px" },
    "8": { "$value": "16px" },
    "9": { "$value": "20px" }
  },

  "radius": {
    "$type": "dimension",
    "sm":    { "$value": "3px",  "$description": "Buttons, rows, chips" },
    "md":    { "$value": "4px",  "$description": "Swatches, small containers" },
    "lg":    { "$value": "5px",  "$description": "Cards" },
    "panel": { "$value": "10px", "$description": "Floating glass panels" }
  },

  "glass": {
    "bg":        { "$value": "rgba(9, 14, 18, 0.55)", "$type": "color", "$description": "Frosted panel fill" },
    "header-bg": { "$value": "rgba(5, 7, 10, 0.35)", "$type": "color", "$description": "Panel header strip" },
    "blur":      { "$value": "14px", "$type": "dimension", "$description": "backdrop-filter blur radius" },
    "saturate":  { "$value": "140%", "$type": "number", "$description": "backdrop-filter saturation" }
  },

  "shadow": {
    "panel": { "$value": "0 14px 34px rgba(0, 0, 0, 0.4)", "$type": "shadow", "$description": "Floating panel drop shadow" }
  },

  "layout": {
    "$type": "dimension",
    "inset":       { "$value": "{space.8}", "$description": "Gap between floating panels and the viewport edge" },
    "panel-width": { "$value": "320px", "$description": "Mission Control panel width" },
    "map-width":   { "$value": "300px", "$description": "Ground-track map width (collapsed)" },
    "map-height":  { "$value": "200px", "$description": "Ground-track map height (collapsed)" }
  },

  "motion": {
    "fast": { "$value": "0.15s ease", "$type": "transition", "$description": "Hover and state transitions" }
  }
}
